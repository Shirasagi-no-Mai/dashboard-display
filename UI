    port, user = st.session_state.sel_folder, st.session_state.sel_user

    if port == "原始数据" and user == "精算数据":
        # 特殊处理：直接指定精算汇总表
        target_files = ["精算汇总表.xlsx"]
    elif port == "原始数据":
        target_files = [f"LAX-{user}.xlsx", f"MIA-{user}.xlsx", f"ORD-{user}.xlsx"]
    else:
        target_files = [f"{port}-{user}-日报.xlsx", f"{port}-{user}-实报实销.xlsx"]
    valid_files = [f for f in target_files if os.path.exists(os.path.join(BASE_DIR, f))]

    if not valid_files:
        st.warning("该分类下暂无报表文件。")
    else:
        # 文件选择和日期筛选放在同一行区域
        col_f, col_d = st.columns([1, 2])
        with col_f:
            selected_file = st.selectbox("文件列表", valid_files, label_visibility="visible")

        df_raw = load_data(selected_file)

        if df_raw is not None:
            # --- 日期过滤逻辑 ---
            date_col = None
            for col in ["ETA", "日期", "Inputdate", "Date"]:
                if col in df_raw.columns:
                    date_col = col
                    break

            df_filtered = df_raw.copy()

            if date_col and df_filtered[date_col].dtype == 'datetime64[ns]':
                with col_d:
                    # 已經是 datetime 格式，直接用
                    min_d = df_filtered[date_col].min()
                    max_d = df_filtered[date_col].max()

                    # 容錯
                    if pd.isnull(min_d): min_d = datetime.now()
                    if pd.isnull(max_d): max_d = datetime.now()

                    date_range = st.date_input(
                        f"筛选范围 (基于 {date_col})",
                        value=(min_d.date(), max_d.date()),
                        min_value=min_d.date() if not pd.isnull(min_d) else None,
                        max_value=max_d.date() if not pd.isnull(max_d) else None,
                        key=f"date_filter_{selected_file}"
                    )

                    if isinstance(date_range, tuple) and len(date_range) == 2:
                        start_date, end_date = date_range
                        mask = (df_filtered[date_col].dt.date >= start_date) & \
                               (df_filtered[date_col].dt.date <= end_date)
                        df_filtered = df_filtered.loc[mask]

                # 最終顯示用：轉成友好的字串格式
                if date_col in df_filtered.columns:
                    df_filtered[date_col] = df_filtered[date_col].apply(
                        lambda x: x.strftime('%Y-%m-%d %H:%M:%S') if pd.notnull(x) else ""
                    )

            # 所有欄位轉字串，給 AgGrid 用
            df_filtered = df_filtered.astype(str).replace({"nan": "", "NaT": "", "None": ""})

            if "Index" not in df_filtered.columns:
                df_filtered.insert(0, "Index", range(1, len(df_filtered) + 1))

            st.write("---")
            t_col, dl_col = st.columns([4, 1])
            with t_col:
                st.write(f"**当前编辑：{selected_file} (共 {len(df_filtered)} 行)**")
            with dl_col:
                st.markdown('<div class="back-btn-box">', unsafe_allow_html=True)
                towrite = BytesIO()
                df_filtered.to_excel(towrite, index=False, engine='openpyxl')
                st.download_button("下载当前文档", towrite.getvalue(), file_name=f"Filtered_{selected_file}",
                                   use_container_width=True)
                st.markdown('</div>', unsafe_allow_html=True)

            # --- AgGrid 配置 ---
            gb = GridOptionsBuilder.from_dataframe(df_filtered)
            vertical_line_style = {'border-right': '1px solid #d0d0d0'}
            gb.configure_default_column(
                editable=True, filter=True, sortable=True, resizable=True,
                autoHeight=False, wrapText=False, minWidth=150,
                cellStyle=vertical_line_style
            )
            gb.configure_column(
                "Index", width=80, pinned='left', cellStyle=vertical_line_style
            )
            gb.configure_side_bar(filters_panel=False, columns_panel=True)
            gb.configure_pagination(enabled=True, paginationAutoPageSize=False, paginationPageSize=50)
            gb.configure_selection(selection_mode="multiple", use_checkbox=True)

            gb.configure_grid_options(
                enableRangeSelection=True,
                enableFillHandle=True,
                rowDragManaged=True,
                suppressColumnVirtualisation=True,
                domLayout='normal',
                alwaysShowHorizontalScroll=True
            )

            res = AgGrid(
                df_filtered,
                gridOptions=gb.build(),
                height=800,
                theme='alpine',
                update_mode=GridUpdateMode.VALUE_CHANGED,
                enable_enterprise_modules=True,
                fit_columns_on_grid_load=False,
                key=f"grid_{selected_file}_{len(df_filtered)}"
            )

            if st.button("💾 确认提交修改", type="primary", use_container_width=True):
                try:
                    save_df = pd.DataFrame(res['data'])
                    if "Index" in save_df.columns:
                        save_df = save_df.drop(columns=["Index"])
                    save_df.to_excel(os.path.join(BASE_DIR, selected_file), index=False)
                    st.toast("✅ 数据已同步（仅保存当前过滤范围内的修改）")
                except Exception as e:
                    st.error(f"保存失败: {e}")
