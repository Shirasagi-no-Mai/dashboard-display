                                color='评价', color_discrete_map={'优化': '#00CC96', '恶化': '#EF553B'},
                                hover_data=['基准值', '对比值', '变化'])  # 显式传入供 customdata 使用

                fig_cb.update_layout(
                    hoverlabel=dict(bgcolor="#F8F9FA", font_size=18, font_family="Arial Black"),
                    yaxis_tickformat='.0%', title=f"{port_cb} 环比分析 (鼠标悬浮查看 6 位小数)"
                )
                fig_cb.update_traces(
                    # 修正：customdata 对应 hover_data 的顺序 [基准值, 对比值, 变化]
                    hovertemplate="<b>指标: %{x}</b><br><br>基准值: %{customdata[0]:.6f}<br>对比值: %{customdata[1]:.6f}<br>变化率: %{customdata[2]:+.4%}<extra></extra>",
                    textposition='outside'
                )
                st.plotly_chart(fig_cb, use_container_width=True)

