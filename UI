# 原报表界面
elif st.session_state.stage == "FILE":
    port, user = st.session_state.sel_folder, st.session_state.sel_user
    v_files = [f for f in
               [f"{port}-{user}-日报.xlsx", f"{port}-{user}-实报实销.xlsx", f"LAX-{user}.xlsx", f"MIA-{user}.xlsx",
                f"ORD-{user}.xlsx", "精算汇总表.xlsx"] if os.path.exists(os.path.join(BASE_DIR, f))]
    if not v_files:
        st.warning("暂无报表。")
    else:
        cf, cd = st.columns([1, 2]);
        sf = cf.selectbox("文件选择", v_files)
        df_raw = load_data(sf)
        if df_raw is not None:
            date_col = next((c for c in ["ETA", "日期", "Inputdate", "Date"] if c in df_raw.columns), None)
            df_filtered = df_raw.copy()
            if date_col and df_filtered[date_col].dtype == 'datetime64[ns]':
                with cd:
                    min_d = df_filtered[date_col].min()
                    dr = st.date_input("日期范围",
                                       value=(min_d.date() if not pd.isnull(min_d) else datetime.now().date(),
                                              datetime.now().date()))

                    # --- 下面是修改后的过滤逻辑 ---
                    if isinstance(dr, tuple) and len(dr) == 2:
                        start_ts = pd.Timestamp(dr[0])
                        end_ts = pd.Timestamp(dr[1]) + pd.Timedelta(hours=23, minutes=59, seconds=59)
                        df_filtered = df_filtered[
                            (df_filtered[date_col] >= start_ts) & (df_filtered[date_col] <= end_ts)
                            ]
            df_filtered = df_filtered.astype(str).replace({"nan": ""})
            if "Index" not in df_filtered.columns: df_filtered.insert(0, "Index", range(1, len(df_filtered) + 1))
            st.write("---")
            t_col, dl_col = st.columns([4, 1]);
            t_col.write(f"**文件编辑：{sf} ({len(df_filtered)} 行)**")
            with dl_col:
                tow = BytesIO();
                df_filtered.to_excel(tow, index=False)
                st.download_button("下载文档", tow.getvalue(), file_name=f"Filtered_{sf}", use_container_width=True)

            gb = GridOptionsBuilder.from_dataframe(df_filtered)
            gb.configure_default_column(editable=True, filter=True, sortable=True, resizable=True, minWidth=150,
                                        cellStyle={'border-right': '1px solid #d0d0d0'})
            gb.configure_grid_options(enableRangeSelection=True, enableFillHandle=True, rowDragManaged=True,
                                      suppressColumnVirtualisation=True, domLayout='normal',
                                      alwaysShowHorizontalScroll=True)
            gb.configure_pagination(enabled=True, paginationAutoPageSize=False, paginationPageSize=50)
            gb.configure_side_bar(filters_panel=False, columns_panel=True)
            gb.configure_selection(selection_mode="multiple", use_checkbox=True)
            gb.configure_column("Index", width=90, pinned='left', checkboxSelection=True, headerCheckboxSelection=True)

            res = AgGrid(df_filtered, gridOptions=gb.build(), height=800, theme='alpine',
                         update_mode=GridUpdateMode.VALUE_CHANGED, enable_enterprise_modules=True)
            if st.button("💾 确认保存修改", type="primary", use_container_width=True):
                save_df = pd.DataFrame(res['data'])
                if "Index" in save_df.columns: save_df = save_df.drop(columns=["Index"])
                save_df.to_excel(os.path.join(BASE_DIR, sf), index=False);
                st.toast("✅ 数据同步完成")
