def robust_parse_date(date_str):
    if pd.isna(date_str) or str(date_str).strip() == "": return pd.NaT
    s = str(date_str).strip().replace("年", "-").replace("月", "-").replace("日", "").replace("/", "-").replace(".",
                                                                                                                "-")
    fmts = ["%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d", "%m-%d-%Y", "%m/%d/%Y"]
    for fmt in fmts:
        try:
            return pd.to_datetime(s, format=fmt, errors='raise')
        except:
            pass
    try:
        return pd.to_datetime(s, errors='raise')
    except:
        return pd.NaT


def load_data(file_name, skip_date_parsing=False):
    path = os.path.join(BASE_DIR, file_name)
    if not os.path.exists(path): return None
    try:
        df = pd.read_excel(path, engine='openpyxl')
        if skip_date_parsing: return df.fillna("")
        p_cols = ["ETA", "日期", "Inputdate", "Date"]
        date_col = next((c for c in p_cols if c in df.columns), None)
        if date_col:
            df[date_col] = df[date_col].astype(str).replace(['nan', 'NaT', 'None', ''], np.nan)
            df[date_col] = df[date_col].apply(robust_parse_date)
        return df.fillna("")
    except:
        return None


def get_weighted_mean(df_sub, metric_col, weight_col='清关单量'):
    w = pd.to_numeric(df_sub[weight_col], errors='coerce').fillna(0)
    m = pd.to_numeric(df_sub[metric_col], errors='coerce').fillna(0)
    if w.sum() == 0: return 0
    return (m * w).sum() / w.sum()


def draw_actuarial_trend(target_df, metrics, title):
    fig = go.Figure()
    v_vol = pd.to_numeric(target_df['清关单量'], errors='coerce').fillna(0).values
    # 计算环比百分比
    pct_vol = [0.0] + [(v_vol[i] - v_vol[i - 1]) / v_vol[i - 1] if v_vol[i - 1] != 0 else 0 for i in
                       range(1, len(v_vol))]

    # 主轴：清关单量 (显示：数值 + 百分比)
    fig.add_trace(go.Scatter(
        x=target_df['时间'], y=v_vol, name="清关单量", mode='lines+markers+text',
        text=[f"{v:,.0f}<br>({p:+.1%})" if i > 0 else f"{v:,.0f}" for i, (v, p) in enumerate(zip(v_vol, pct_vol))],
        textposition="top center", line=dict(color='#636EFA', width=4)
    ))

    colors = ['#EF553B', '#00CC96', '#AB63FA', '#FFA15A']
    for i, m in enumerate(metrics):
        v_m = pd.to_numeric(target_df[m], errors='coerce').fillna(0).values
        pct_m = [0.0] + [(v_m[i] - v_m[i - 1]) / abs(v_m[i - 1]) if v_m[i - 1] != 0 else 0 for i in range(1, len(v_m))]
        # 副轴指标 (显示：数值 + 百分比)
        fig.add_trace(go.Scatter(
            x=target_df['时间'], y=v_m, name=m, yaxis="y2", mode='lines+markers+text',
            text=[f"{v:.2f}<br>({p:+.1%})" if i > 0 else f"{v:.2f}" for i, (v, p) in enumerate(zip(v_m, pct_m))],
            textposition="bottom center",
            line=dict(color=colors[i % len(colors)], width=2, dash='dot' if i > 0 else None)
        ))

    fig.update_layout(
        title=title, yaxis=dict(title="清关单量"),
        yaxis2=dict(title="值", overlaying='y', side='right', showgrid=False),
        hovermode="x unified", margin=dict(t=80, b=50)
    )
    # 核心修改：cliponaxis=False 保证文字不被裁切
    fig.update_traces(cliponaxis=False)
    return fig


