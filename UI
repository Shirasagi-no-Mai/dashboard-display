# 阶段 3：文件处理与 AgGrid (最核心 200 行在这里)
elif st.session_state.stage == "FILE":
    port, user = st.session_state.sel_folder, st.session_state.sel_user
    
    # 找回完整的目标文件匹配逻辑
    if port == "原始数据" and user == "精算数据":
        target_files = ["精算汇总表.xlsx"]
    elif port == "原始数据":
        target_files = [f"LAX-{user}.xlsx", f"MIA-{user}.xlsx", f"ORD-{user}.xlsx"]
    else:
        target_files = [f"{port}-{user}-日报.xlsx", f"{port}-{user}-实报实销.xlsx"]
    
    valid_files = [f for f in target_files if os.path.exists(os.path.join(BASE_DIR, f))]

    if not valid_files:
        st.warning(f"⚠️ 在 {BASE_DIR} 下未找到对应的 {user} 报表文件。")
    else:
        col_f, col_d = st.columns([1, 2])
        with col_f:
            selected_file = st.selectbox("📑 切换报表文件", valid_files, label_visibility="visible")

        # 加载原始数据
        df_raw = load_data(selected_file)

        if df_raw is not None:
            # 确定日期列
            date_col = next((col for col in ["ETA", "日期", "Inputdate", "Date"] if col in df_raw.columns), None)
            df_filtered = df_raw.copy()

            # --- 彻底修复 2026 日期筛选与灰色禁用问题 ---
            if date_col and pd.api.types.is_datetime64_any_dtype(df_filtered[date_col]):
                with col_d:
                    valid_dates = df_filtered[date_col].dropna()
                    if not valid_dates.empty:
                        min_d = valid_dates.min().date()
                        max_d = valid_dates.max().date()
                        # 重点：如果数据有 2026，这里 cal_limit 就会包含 2026，解决灰色点击问题
                        cal_limit = max(max_d, datetime.now().date())
                        
                        date_range = st.date_input(
                            f"📅 筛选 {date_col} 范围 (数据最大值: {max_d})",
                            value=(min_d, max_d),
                            min_value=datetime(2023, 1, 1).date(),
                            max_value=cal_limit,
                            key=f"dr_{selected_file}"
                        )
                        
                        # 执行过滤，确保只显示选定年份单子
                        if isinstance(date_range, tuple) and len(date_range) == 2:
                            df_filtered = df_filtered[
                                (df_filtered[date_col].dt.date >= date_range[0]) & 
                                (df_filtered[date_col].dt.date <= date_range[1])
                            ]
                    else:
                        st.info("ℹ️ 当前文件日期列数据不规范，已跳过日期筛选。")

            # --- 准备 AgGrid 最终显示数据 ---
            display_df = df_filtered.copy()
            # 转换日期格式供前端展示
            if date_col in display_df.columns:
                display_df[date_col] = display_df[date_col].dt.strftime('%Y-%m-%d %H:%M:%S').fillna("")
            
            # 补齐所有空值，防止 AgGrid 报错
            display_df = display_df.fillna("").astype(str)
            
            # 找回自动索引插入逻辑
            if "Index" not in display_df.columns:
                display_df.insert(0, "Index", range(1, len(display_df) + 1))

            st.write("---")
            
            # 表头操作区
            t_col, dl_col = st.columns([4, 1])
            with t_col:
                st.markdown(f"📝 **当前编辑：** `{selected_file}` | 📊 **当前数据量：** `{len(display_df)}` 行")
            with dl_col:
                # 找回 Excel 下载导出逻辑
                towrite = BytesIO()
                display_df.to_excel(towrite, index=False, engine='openpyxl')
                st.download_button(
                    "📥 下载当前筛选文档", 
                    towrite.getvalue(), 
                    file_name=f"Filtered_{selected_file}",
                    use_container_width=True
                )

            # --- AgGrid 找回丢失的 50+ 行企业级配置 ---
            gb = GridOptionsBuilder.from_dataframe(display_df)
            v_line_style = {'border-right': '1px solid #d0d0d0', 'background-color': '#ffffff'}
            
            # 默认列定义
            gb.configure_default_column(
                editable=True, 
                filter=True, 
                sortable=True, 
                resizable=True,
                autoHeight=False, 
                wrapText=False, 
                minWidth=160,
                cellStyle=v_line_style
            )
            
            # 找回 Index 列锁定配置
            gb.configure_column(
                "Index", 
                width=90, 
                pinned='left', 
                cellStyle={'border-right': '2px solid #007bff', 'font-weight': 'bold'}
            )
            
            # 找回侧边栏和分页配置
            gb.configure_side_bar(filters_panel=False, columns_panel=True)
            gb.configure_pagination(enabled=True, paginationAutoPageSize=False, paginationPageSize=50)
            gb.configure_selection(selection_mode="multiple", use_checkbox=True)
            
            # 找回企业级特性支持 (RangeSelection, FillHandle)
            gb.configure_grid_options(
                enableRangeSelection=True,      # 找回范围选择
                enableFillHandle=True,         # 找回像 Excel 一样的下拉填充
                rowDragManaged=True,           # 找回行拖拽
                suppressColumnVirtualisation=True,
                domLayout='normal',
                alwaysShowHorizontalScroll=True,
                groupHeaderHeight=40,
                headerHeight=45
            )

            # 渲染表格
            res = AgGrid(
                display_df, 
                gridOptions=gb.build(), 
                height=750, 
                theme='alpine',
                update_mode=GridUpdateMode.VALUE_CHANGED, 
                data_return_mode=DataReturnMode.FILTERED_AND_SORTED, # 找回数据返回模式
                enable_enterprise_modules=True,   # 必须开启以支持 FillHandle
                fit_columns_on_grid_load=False, 
                key=f"full_grid_{selected_file}_{len(display_df)}"
            )

            # --- 提交同步逻辑 (确保保存完整性) ---
            st.write("")
            if st.button("🚀 确认提交并同步修改到原始文件", type="primary", use_container_width=True):
                try:
                    # 获取 AgGrid 返回的修改后数据
                    updated_data = pd.DataFrame(res['data'])
                    if "Index" in updated_data.columns:
                        updated_data = updated_data.drop(columns=["Index"])
                    
                    # 写入 Excel
                    save_path = os.path.join(BASE_DIR, selected_file)
                    updated_data.to_excel(save_path, index=False)
                    
                    st.success(f"💾 同步成功！数据已更新至：{selected_file}")
                    st.toast("✅ 数据已持久化保存")
                except Exception as e:
                    st.error(f"❌ 保存失败！请检查文件是否被 Excel 占用。错误详情: {e}")

