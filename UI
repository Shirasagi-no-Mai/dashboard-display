def robust_parse_date(date_str):
    """找回极致解析逻辑：支持 2026 等未来日期并清理脏字符"""
    if pd.isna(date_str) or str(date_str).strip().lower() in ["nan", "nat", "none", ""]:
        return pd.NaT
    s = str(date_str).strip()
    s = s.replace("年", "-").replace("月", "-").replace("日", "").replace("/", "-").replace(".", "-")
    try:
        # fuzzy=True 适配带杂质的字符串
        return pd.to_datetime(s, errors='raise', fuzzy=True)
    except:
        fmts = [
            "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d",
            "%m-%d-%Y", "%m/%d/%Y", "%m-%d-%y", "%m/%d/%y",
            "%Y/%m/%d", "%d-%m-%Y", "%d/%m/%Y", "%Y.%m.%d", "%Y%m%d"
        ]
        for fmt in fmts:
            try: return pd.to_datetime(s, format=fmt)
            except: continue
    return pd.NaT

def load_data(file_name):
    """增强型数据加载：确保日期列类型稳固，不被 fillna 破坏"""
    path = os.path.join(BASE_DIR, file_name)
    if not os.path.exists(path): return None
    try:
        # 使用 openpyxl 引擎确保读取最新格式
        df = pd.read_excel(path, engine='openpyxl')
        possible_date_cols = ["ETA", "日期", "Inputdate", "Date", "eta", "到港日期", "預計到達"]
        date_col = next((col for col in possible_date_cols if col in df.columns), None)
        
        if date_col:
            # 这里的逻辑关键：先不 fillna，保持 datetime 格式用于后续筛选
            df[date_col] = df[date_col].astype(str).apply(robust_parse_date)
        return df
    except Exception as e:
        st.error(f"文件加载异常: {e}")
        return None

