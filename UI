def robust_parse_date(date_str):
    """盡量寬鬆解析各種日期格式，返回 datetime 或 NaT"""
    if pd.isna(date_str) or str(date_str).strip() == "":
        return pd.NaT

    s = str(date_str).strip()

    # 常見中文/混雜情況先替換
    s = s.replace("年", "-").replace("月", "-").replace("日", "").replace("/", "-").replace(".", "-")
    s = s.replace("上午", " AM").replace("下午", " PM").replace("时", ":").replace("分", ":").replace("秒", "")

    # 去掉多餘空格
    s = " ".join(s.split())

    # 常見格式嘗試列表（優先級由高到低）
    fmts = [
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d %H:%M",
        "%Y-%m-%d",
        "%m-%d-%Y",
        "%m/%d/%Y",
        "%m-%d-%y",
        "%m/%d/%y",
        "%Y/%m/%d",
        "%d-%m-%Y",
        "%d/%m/%Y",
        "%Y.%m.%d",
        "%Y年%m月%d日 %H:%M:%S",
        "%Y年%m月%d日",
        "%m月%d日 %Y",
    ]

    for fmt in fmts:
        try:
            return pd.to_datetime(s, format=fmt, errors='raise')
        except:
            pass

    # 最後再用 pandas 通用解析（比較慢但最寬鬆）
    try:
        return pd.to_datetime(s, errors='raise')
    except:
        return pd.NaT


def load_data(file_name):
    path = os.path.join(BASE_DIR, file_name)
    if not os.path.exists(path):
        return None

    try:
        df = pd.read_excel(path, engine='openpyxl')

        # 尋找可能的日期欄位
        possible_date_cols = ["ETA", "日期", "Inputdate", "Date", "eta", "到港日期", "預計到達"]
        date_col = next((col for col in possible_date_cols if col in df.columns), None)

        if date_col:
            # 強制轉成字串再解析，處理最髒的數據
            df[date_col] = df[date_col].astype(str).replace(['nan', 'NaT', 'None', ''], np.nan)
            df[date_col] = df[date_col].apply(robust_parse_date)

        return df.fillna("")
    except:
        return None


